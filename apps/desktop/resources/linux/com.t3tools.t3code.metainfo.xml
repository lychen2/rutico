  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Rutico</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="io.github.lychen2.rutico">
    <name>Rutico Contributors</name>
  </developer>
  <description>
